import numpy as np

# ===============================
# Matriz A y vector B (3 nodos)
# ===============================
A = np.array([[-2, 1, 1],
              [1, -2, 1],
              [1, 1, -2]])

B = np.array([[150],
              [200],
              [150]])

# ===============================
# Función para verificar si A es invertible
# ===============================
def es_invertible(A):
    return np.linalg.det(A) != 0

# ===============================
# Función para unir matrices (para mostrar la aumentada)
# ===============================
def unir_matrices(A, B):
    return np.concatenate((A, B), axis=1)

# ===============================
# MAIN
# ===============================
print("Matriz A:")
print(A)

print("\nVector B:")
print(B)

# Determinante y verificación
det = np.linalg.det(A)
print("\nDeterminante de A:", det)

# Matriz aumentada
AB = unir_matrices(A, B)
print("\nMatriz aumentada [A|B]:")
print(AB)

# Resolver el sistema
if es_invertible(A):
    print("\nLa matriz A es invertible.")
    A_inv = np.linalg.inv(A)
    print("\nInversa de A:")
    print(A_inv)

    X = np.dot(A_inv, B)
    print("\nSolución del sistema AX = B usando la inversa:")
    print(X)
else:
    print("\nLa matriz A NO es invertible.")
    print("Se usará mínimos cuadrados para aproximar la solución.")
    X, residuals, rank, s = np.linalg.lstsq(A, B, rcond=None)
    print("\nSolución del sistema AX = B (mínimos cuadrados):")
    print(X)
    if residuals.size > 0:
        print("Residuo:", residuals)

